# Frontend environment — Vercel
# Point the SPA at the Render backend. Set this in Vercel:
#   Settings -> Environment Variables -> VITE_API_URL
# Example: https://applyjin-api.onrender.com
VITE_API_URL=https://your-render-service.onrender.com

# For local dev/preview, leave EMPTY — Vite proxies /api to localhost:8000.
